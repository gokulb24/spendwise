rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user can only ever touch their own profile row.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public-ish lookup: invite code -> family id. Holds NO sensitive data
    // (just the target family's id), so it's safe to read one-by-one, but it
    // must never be listable/enumerable.
    match /invites/{code} {
      allow get:  if request.auth != null;
      allow list: if false;
      // Only the owner of the referenced family may create/point an invite at it,
      // so nobody can hijack an existing code to redirect joiners.
      allow create, update: if request.auth != null
        && exists(/databases/$(database)/documents/families/$(request.resource.data.familyId))
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.ownerUid == request.auth.uid;
      allow delete: if false;
    }

    match /families/{fid} {
      // Only members can read a family document (names + member emails).
      // NB: use the `in` operator — bracket access on a missing map key can
      // error out in rules, which would wrongly deny a legitimate request.
      allow get:  if request.auth != null
        && request.auth.uid in resource.data.members;
      // Never allow listing/enumerating families.
      allow list: if false;

      // Creator must enrol themselves as a member and be the owner.
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      // Members may edit freely. A non-member may ONLY add themselves as a
      // member (the "join by code" flow) and touch nothing else.
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members
        || (
          !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        )
      );

      allow delete: if request.auth != null
        && request.auth.uid in resource.data.members;

      // All family data (expenses, goals, debts, etc.) — members only.
      match /{document=**} {
        allow read, write: if request.auth != null
          && request.auth.uid in
             get(/databases/$(database)/documents/families/$(fid)).data.members;
      }
    }
  }
}
